{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Smoozy",
  "version": "0.2.0",
  "identifier": "com.smoozy.desktop",
  "build": {
    "frontendDist": "web"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [],
    "security": {
      "csp": {
        "default-src": "'none'",
        "script-src": "'self'",
        "style-src": "'self'",
        "img-src": "'self' blob:",
        "connect-src": "ipc: http://ipc.localhost",
        "object-src": "'none'",
        "base-uri": "'none'",
        "frame-src": "'none'",
        "form-action": "'none'",
        "frame-ancestors": "'none'"
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "app"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "11.0",
      "files": {
        "Resources/PrivacyInfo.xcprivacy": "PrivacyInfo.xcprivacy",
        "Resources/COPYING": "../../COPYING",
        "Resources/THIRD-PARTY-LICENSES.txt": "../Release/generated-notices/THIRD-PARTY-LICENSES.txt"
      }
    },
    "linux": {
      "deb": {
        "depends": [
          "libc6 (>= 2.39)",
          "packagekit",
          "libgtk-3-0t64",
          "libwebkit2gtk-4.1-0"
        ],
        "files": {
          "/usr/share/doc/smoozy/copyright": "../Release/generated-notices/copyright",
          "/usr/share/doc/smoozy/COPYING": "../../COPYING",
          "/usr/share/doc/smoozy/THIRD-PARTY-LICENSES.txt": "../Release/generated-notices/THIRD-PARTY-LICENSES.txt"
        }
      }
    },
    "windows": {
      "webviewInstallMode": {
        "type": "embedBootstrapper"
      }
    }
  }
}
